{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppCenter",
  "version": "0.1.0",
  "identifier": "com.appcenter.desktop",
  "build": {
    "frontendDist": "../src-tauri/frontend",
    "beforeDevCommand": "",
    "devUrl": ""
  },
  "app": {
    "windows": [
      {
        "title": "应用中心",
        "width": 1237,
        "height": 762,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
